{
  "name": "greek-bible-teacher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @gbt/web dev",
    "dev:api": "pnpm --filter @gbt/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @gbt/api db:generate",
    "db:migrate": "pnpm --filter @gbt/api db:migrate",
    "data:fetch": "pnpm --filter @gbt/api data:fetch",
    "ingest": "pnpm --filter @gbt/api ingest"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.5.1"
}
