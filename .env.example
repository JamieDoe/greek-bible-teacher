# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# --- Postgres (docker compose) ---
POSTGRES_USER=greek
POSTGRES_PASSWORD=change-me
POSTGRES_DB=greek
POSTGRES_PORT=5432

# --- API (apps/api) ---
DATABASE_URL=postgres://greek:change-me@localhost:5432/greek
API_PORT=8787
# Exact origin of the web app; the only origin CORS allows.
WEB_ORIGIN=http://localhost:3000

# Per-IP rate limits (0 = off). Off by default outside production; see DECISIONS 025.
# RATE_LIMIT_PER_MINUTE=600
# NEW_SESSIONS_PER_HOUR=60

# --- Web (apps/web) ---
# Where the Next server reaches the API: for Server Components and the /api/* rewrite.
# The rewrite is fixed at `next build` time. Defaults to http://localhost:8787.
# API_INTERNAL_URL=http://localhost:8787

# --- Tests (optional) ---
# API tests drop and recreate this DB on every run. Defaults to DATABASE_URL's name + "_test".
# TEST_DATABASE_URL=postgres://greek:change-me@localhost:5432/greek_test
