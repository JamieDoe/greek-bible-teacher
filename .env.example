# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# --- Postgres (docker compose) ---
POSTGRES_USER=greek
POSTGRES_PASSWORD=change-me
POSTGRES_DB=greek
POSTGRES_PORT=5432

# --- API (apps/api) ---
# Used by the DB client from Phase 1 onwards.
DATABASE_URL=postgres://greek:change-me@localhost:5432/greek
API_PORT=8787
# Exact origin of the web app; the only origin CORS allows.
WEB_ORIGIN=http://localhost:3000
