# Production settings for deploy/docker-compose.yml. Copy to deploy/.env on the server (it is
# gitignored) and never commit the real file.

# Public hostname; DNS A/AAAA records must point at this server before the first start.
DOMAIN=greek.example.org
# For Let's Encrypt expiry notices (the operator's address, not a user's).
ACME_EMAIL=admin@example.org

POSTGRES_USER=greek
POSTGRES_DB=greek
# URL-safe, since it is embedded in DATABASE_URL: generate with `openssl rand -hex 32`.
POSTGRES_PASSWORD=change-me

# Optional: image tag for gbt-api / gbt-web (e.g. a git SHA), and host ports for Caddy.
# IMAGE_TAG=latest
# HTTP_PORT=80
# HTTPS_PORT=443
